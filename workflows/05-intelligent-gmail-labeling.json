    {
      "parameters": {
        "jsCode": "const required = ['Quotation', 'Project progress', 'Inquiry', 'Notification'];\nconst existingNames = new Set(\n  $('Get existing labels (ensure)').all().map((item) => item.json.name)\n);\n\nconst missing = required.filter((name) => !existingNames.has(name));\n\nif (missing.length === 0) {\n  return [{ json: { skipCreate: true } }];\n}\n\nreturn missing.map((name) => ({ json: { name } }));"
      },
      "id": "e7b2a1c0-3d4e-5f60-7081-92a3b4c5d6e7",
