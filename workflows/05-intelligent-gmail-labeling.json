    {
      "parameters": {
        "content": "### Ensure labels exist\nCreates **Quotation**, **Project progress**, **Inquiry**, and **Notification** in Gmail if missing.",
        "height": 120,
        "width": 680
      },
      "id": "b4a9c8d7-0a1b-2c30-4050-60a0b1c2d3e4",
      "name": "Sticky Note18",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        704,
        64
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "const aiLabels = $('Split out assigned labels').all().map((item) => item.json.labels);\nconst gmailLabels = $('Get all labels').all();\n\nconst labelIds = [];\nconst missing = [];\n\nfor (const name of aiLabels) {\n  const match = gmailLabels.find((g) => g.json.name === name);\n  if (match) {\n    labelIds.push(match.json.id);\n  } else {\n    missing.push(name);\n  }\n}\n\nif (labelIds.length === 0) {\n  throw new Error(\n    'No matching Gmail labels for AI categories: ' +\n      aiLabels.join(', ') +\n      '. Missing in Gmail: ' +\n      missing.join(', ') +\n      '. Run from Gmail trigger so labels are auto-created, or create them manually.'\n  );\n}\n\nreturn [{ json: { label_ids: labelIds, matched: labelIds.length, missing } }];"
      },
      "id": "b1c2d3e4-f5a6-7890-bcde-f12345678902",
      "name": "Resolve label IDs",
      "type": "n8n-nodes-base.code",
      "position": [
