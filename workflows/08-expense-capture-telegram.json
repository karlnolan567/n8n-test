      "id": "http-openrouter-001",
      "name": "OpenRouter Vision Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "continueOnFail": true,
      "credentials": {
        "openRouterApi": {
          "id": "GbWxyoiTDgAOOz1u",
          "name": "OpenRouter Expense N8N"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prep Image + Meta').first().json;\nconst raw = $input.first().json;\nif (raw.error || raw.message === 'No endpoints found' || (raw.error && raw.error.message)) {\n  const msg = (raw.error && (raw.error.message || raw.error.description)) || raw.description || raw.message || 'OpenRouter request failed';\n  return [{ json: { ok: false, chatId: prep.chatId, error: String(msg) } }];\n}\nconst content = (((raw.choices || [])[0] || {}).message || {}).content || '';\nlet text = typeof content === 'string' ? content : JSON.stringify(content);\ntext = text.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(text);\n} catch (e) {\n  return [{ json: { ok: false, chatId: prep.chatId, error: 'Could not parse model JSON', raw: text.slice(0, 500) } }];\n}\nif (parsed.error || (!parsed.vendor && !parsed.amount)) {\n  return [{ json: { ok: false, chatId: prep.chatId, error: 'Photo does not look like a usable receipt', raw: parsed } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    recordId: prep.recordId,\n    date: parsed.date || '',\n    vendor: parsed.vendor || '',\n    amount: parsed.amount || '',\n    currency: parsed.currency || '',\n    tax: parsed.tax || '',\n    category: parsed.category || '',\n    notes: parsed.notes || '',\n    status: 'pending approval',\n    capturedAt: prep.capturedAt,\n    telegramDisplayName: prep.telegramDisplayName,\n    telegramUserId: prep.telegramUserId,\n    telegramUser: prep.telegramUser,\n    chatId: prep.chatId,\n    telegramChatId: prep.telegramChatId\n  }\n}];"
      },
