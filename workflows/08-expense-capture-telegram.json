        "jsCode": "const cq = $json.callback_query || {};\nconst from = cq.from || {};\nconst msg = cq.message || {};\nconst chatId = (msg.chat && msg.chat.id) || (from && from.id);\nconst queryId = cq.id;\nconst messageId = msg.message_id;\nconst originalText = msg.text || '';\nconst raw = String(cq.data || '');\nconst parts = raw.split(':');\nconst action = (parts[0] || '').toLowerCase();\nconst recordId = parts.slice(1).join(':');\nif (String(from.id) !== '7813999484') {\n  return [{ json: { ok: false, chatId, queryId, messageId, error: 'Unauthorized approver' } }];\n}\nif (!recordId || (action !== 'approve' && action !== 'reject')) {\n  return [{ json: { ok: false, chatId, queryId, messageId, error: 'Unknown approval action' } }];\n}\nreturn [{ json: { ok: true, approved: action === 'approve', recordId, chatId, queryId, messageId, originalText } }];"
