      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Just send a receipt photo or image file (PNG/JPG) \u2014 no caption needed.\n\nI will extract the details, add a Sheet row as pending approval, and show Approve/Reject buttons here in Telegram.\n\n/start only shows this help message.",
