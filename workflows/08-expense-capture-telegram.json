    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "I only process receipt images. Send a photo or image file (PNG/JPG) with no special caption.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "tg-need-photo-001",
      "name": "Reply Need Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1000,
        720
      ],
      "credentials": {
        "telegramApi": {
          "id": "mNLRMbumJp8Nifvy",
          "name": "Telegram Expense Capture"
        }
      }
