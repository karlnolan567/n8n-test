{
  "name": "02 - Gmail AI Draft Reply",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyMinute" }]
        },
        "simple": true,
        "filters": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_GMAIL_CREDENTIAL",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2\",\n  \"stream\": false,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarize this email in 3-5 bullet points. Subject: \" + $json.subject + \"\\nFrom: \" + $json.from + \"\\nBody: \" + ($json.textPlain || $json.snippet || '')\n    }\n  ]\n}",
        "options": { "timeout": 120000 }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000002",
      "name": "Summarize Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3.2\",\n  \"stream\": false,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You write professional, concise email replies. Output only the email body text (no subject line).\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a draft reply to this email.\\n\\nOriginal subject: \" + $('Gmail Trigger').item.json.subject + \"\\nOriginal from: \" + $('Gmail Trigger').item.json.from + \"\\nOriginal body: \" + ($('Gmail Trigger').item.json.textPlain || $('Gmail Trigger').item.json.snippet || '') + \"\\n\\nSummary: \" + $json.message.content\n    }\n  ]\n}",
        "options": { "timeout": 120000 }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000003",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=Re: {{ $('Gmail Trigger').item.json.subject }}",
        "message": "={{ $json.message.content }}",
        "options": {
          "threadId": "={{ $('Gmail Trigger').item.json.threadId }}"
        }
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000004",
      "name": "Create Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_GMAIL_CREDENTIAL",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "summary",
              "value": "={{ $('Summarize Email').item.json.message.content }}",
              "type": "string"
            },
            {
              "id": "s2",
              "name": "draftBody",
              "value": "={{ $('Draft Reply').item.json.message.content }}",
              "type": "string"
            },
            {
              "id": "s3",
              "name": "draftId",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1b2c3d4-0002-4000-8000-000000000005",
      "name": "Review Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [[{ "node": "Summarize Email", "type": "main", "index": 0 }]]
    },
    "Summarize Email": {
      "main": [[{ "node": "Draft Reply", "type": "main", "index": 0 }]]
    },
    "Draft Reply": {
      "main": [[{ "node": "Create Gmail Draft", "type": "main", "index": 0 }]]
    },
    "Create Gmail Draft": {
      "main": [[{ "node": "Review Output", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
