POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_local_dev_change_me
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_USER_MANAGEMENT_JWT_SECRET=replace-with-another-long-random-string
GENERIC_TIMEZONE=America/Los_Angeles
TZ=America/Los_Angeles
OLLAMA_HOST=ollama:11434
QDRANT_URL=http://qdrant:6333

# n8n 2.x: Read/Write Files node may only access these container paths (semicolon-separated)
# N8N_RESTRICT_FILE_ACCESS_TO=/data;/home/node/.n8n-files

# Required for GitHub/Telegram/webhook triggers and Google Chat "Send and Wait" —
# must be a public HTTPS URL (not localhost). Example after: ./scripts/setup-ngrok-webhook.sh
# WEBHOOK_URL=https://abc123.ngrok-free.app/
# N8N_EDITOR_BASE_URL=https://abc123.ngrok-free.app/

# Expense capture demo: put Telegram / OpenRouter / Google credentials in the n8n UI
# (not in .env). See docs/expense-capture/local-provisioning-checklist.md

# GitHub owner/repo for Code Companion trigger (configure in workflow UI too)
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
