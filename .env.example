# Required for GitHub/webhook triggers — must be a public URL (not localhost).
# Example after running: ngrok http 5678
# WEBHOOK_URL=https://abc123.ngrok-free.app/
# N8N_EDITOR_BASE_URL=https://abc123.ngrok-free.app/
# GitHub owner/repo for Code Companion trigger (configure in workflow UI too)
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
